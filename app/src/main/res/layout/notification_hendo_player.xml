<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="136dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/notification_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#E6FFFFFF"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/notification_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="14dp"
            android:progressTint="#FFA855F7" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/notification_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#E6FFFFFF"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/notification_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E6FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/notification_previous"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@null"
                android:contentDescription="이전 곡"
                android:src="@drawable/ic_notification_previous"
                android:tint="#FFFFFFFF" />

            <TextView android:layout_width="10dp" android:layout_height="1dp" />

            <ImageView
                android:id="@+id/notification_play_pause"
                android:layout_width="30dp"
                android:layout_height="28dp"
                android:background="@null"
                android:contentDescription="재생 또는 일시정지"
                android:tint="#FFFFFFFF" />

            <TextView android:layout_width="10dp" android:layout_height="1dp" />

            <ImageView
                android:id="@+id/notification_next"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@null"
                android:contentDescription="다음 곡"
                android:src="@drawable/ic_notification_next"
                android:tint="#FFFFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/notification_favorite"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@null"
                android:contentDescription="좋아요"
                android:src="@drawable/ic_notification_heart"
                android:tint="#FFFFFFFF" />

            <TextView android:layout_width="14dp" android:layout_height="1dp" />

            <ImageView
                android:id="@+id/notification_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@null"
                android:contentDescription="재생 종료"
                android:src="@drawable/ic_notification_close"
                android:tint="#FFFFFFFF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
